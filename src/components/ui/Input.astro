---
interface Props {
  label?: string;
  name: string;
  type?: string;
  placeholder?: string;
  value?: string;
  required?: boolean;
  class?: string;
}

const { label, name, type = 'text', placeholder, value, required = false, class: className = '' } =
  Astro.props;
---

<label class="block font-mono">
  {label && (
    <span class="mb-1 block text-xs font-bold uppercase tracking-wider">{label}</span>
  )}
  <input
    type={type as never}
    name={name}
    placeholder={placeholder}
    value={value}
    required={required}
    class={`w-full rounded-sm border-2 border-ink bg-paper font-mono px-3 py-2 focus:outline-none focus:shadow-riso-focus riso-interactive placeholder:text-gray-500 ${className}`}
  />
</label>
