---
interface Props {
  text?: string;
  class?: string;
}

const { text = '加载中……', class: className = '' } = Astro.props;
---

<div
  class={`rounded-sm bg-paper border-2 border-ink shadow-riso-lg p-8 font-mono ${className}`}
  role="status"
  aria-live="polite"
>
  <span class="inline-block h-4 w-4 mr-3 bg-riso-pink border-2 border-ink align-middle"></span>
  <span class="text-sm uppercase tracking-wider">{text}</span>
</div>
