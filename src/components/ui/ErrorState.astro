---
interface Props {
  title?: string;
  class?: string;
}

const { title = '出错了', class: className = '' } = Astro.props;
---

<div
  class={`rounded-sm bg-paper border-2 border-riso-orange shadow-[4px_4px_0_0_#ff8a00,-2px_-2px_0_0_#ff6b9d] p-8 font-mono ${className}`}
>
  <p class="font-bold uppercase tracking-wider text-lg text-riso-orange">{title}</p>
  <div class="mt-4 text-sm text-gray-700">
    <slot />
  </div>
</div>
