---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Card from '@/components/ui/Card.astro';
import SocialIcon from '@/components/SocialIcon.astro';
import { SITE } from '@/config';
---

<BaseLayout title="关于">
  <div class="max-w-4xl mx-auto px-4 md:px-8 py-12 md:py-20">
    <h1 class="font-black text-3xl md:text-5xl uppercase tracking-wider mb-8">关于我</h1>

    <div class="space-y-6">
      <Card>
        <h2 class="font-bold text-xl md:text-2xl uppercase tracking-wider mb-3">简介</h2>
        <p class="text-sm md:text-base text-gray-700">
          {SITE.author || '博主简介待补充。'}
        </p>
      </Card>

      <Card>
        <h2 class="font-bold text-xl md:text-2xl uppercase tracking-wider mb-3">联系</h2>
        {
          SITE.social.length > 0 ? (
            <ul class="space-y-2 font-mono text-sm md:text-base text-gray-700">
              {
                SITE.social.map((s) => (
                  <li>
                    <a
                      href={s.url}
                      target={s.url.startsWith('http') ? '_blank' : undefined}
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 hover:text-riso-blue hover:underline underline-offset-4"
                    >
                      <SocialIcon platform={s.platform} size={17} />
                      <span>{s.label}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          ) : (
            <p class="text-sm md:text-base text-gray-700">联系方式待补充。</p>
          )
        }
      </Card>
    </div>
  </div>
</BaseLayout>
