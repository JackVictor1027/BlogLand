---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config';
---

<BaseLayout>
  <main class="min-h-screen flex flex-col items-center justify-center px-4 font-mono">
    <h1 class="font-bold uppercase tracking-wider text-3xl md:text-5xl">
      {SITE.title}
    </h1>
    <p class="mt-6 text-sm md:text-base text-gray-600">
      网站正在搭建中……
    </p>
  </main>
</BaseLayout>
