---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import Card from '@/components/ui/Card.astro';
import Input from '@/components/ui/Input.astro';
import Textarea from '@/components/ui/Textarea.astro';
import TagPill from '@/components/ui/TagPill.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import ErrorState from '@/components/ui/ErrorState.astro';
import LoadingState from '@/components/ui/LoadingState.astro';
---

<BaseLayout title="设计系统 · 老锦的代码与诗">
  <div class="max-w-6xl mx-auto px-4 md:px-8 py-12 md:py-20 font-mono">
    <h1 class="font-black text-3xl md:text-5xl uppercase tracking-wider mb-2">设计系统</h1>
    <p class="text-gray-600 mb-12">Risograph 印刷风基础组件验收页</p>

    <h2 class="font-bold text-xl md:text-2xl uppercase tracking-wider mb-4 mt-10 border-b-2 border-ink pb-2">按钮</h2>
    <div class="flex flex-wrap gap-4 p-6 bg-paper border-2 border-ink shadow-riso-lg rounded-sm">
      <Button>主按钮</Button>
      <Button variant="outline">描边按钮</Button>
      <Button variant="dark">深色按钮</Button>
      <Button size="sm">小按钮</Button>
      <Button size="lg">大按钮</Button>
      <Button disabled>禁用</Button>
      <Button href="/">链接按钮</Button>
    </div>

    <h2 class="font-bold text-xl md:text-2xl uppercase tracking-wider mb-4 mt-12 border-b-2 border-ink pb-2">卡片</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <Card>
        <h3 class="font-bold text-lg mb-2 uppercase tracking-wider">普通卡片</h3>
        <p class="text-sm text-gray-700">这是一张 Risograph 印刷风卡片，硬边双墨版阴影。</p>
      </Card>
      <Card interactive>
        <h3 class="font-bold text-lg mb-2 uppercase tracking-wider">可交互卡片</h3>
        <p class="text-sm text-gray-700">悬停时阴影切换为蓝橙双墨版错位，并整体上移。</p>
      </Card>
    </div>

    <h2 class="font-bold text-xl md:text-2xl uppercase tracking-wider mb-4 mt-12 border-b-2 border-ink pb-2">表单</h2>
    <div class="p-6 bg-paper border-2 border-ink shadow-riso-lg rounded-sm space-y-4">
      <Input label="文章标题" name="title" placeholder="请输入标题" />
      <Input label="标签" name="tags" placeholder="多个标签用逗号分隔" />
      <Textarea label="正文" name="body" placeholder="支持 Markdown……" rows={4} />
    </div>

    <h2 class="font-bold text-xl md:text-2xl uppercase tracking-wider mb-4 mt-12 border-b-2 border-ink pb-2">标签</h2>
    <div class="flex flex-wrap gap-3">
      <TagPill>前端</TagPill>
      <TagPill count={3}>Astro</TagPill>
      <TagPill href="/tags/杂谈" count={1}>杂谈</TagPill>
    </div>

    <h2 class="font-bold text-xl md:text-2xl uppercase tracking-wider mb-4 mt-12 border-b-2 border-ink pb-2">状态组件</h2>
    <div class="space-y-6">
      <EmptyState>还没有任何文章，去看看别处吧。</EmptyState>
      <ErrorState>网络请求失败，请检查 GitHub 连接后重试。</ErrorState>
      <LoadingState />
    </div>

    <h2 class="font-bold text-xl md:text-2xl uppercase tracking-wider mb-4 mt-12 border-b-2 border-ink pb-2">正文排版</h2>
    <Card>
      <article class="prose-riso">
        <h1>一级标题</h1>
        <p>这是一段正文。Risograph 印刷风正文使用等宽字体，行宽控制在 65-75 字符以内。</p>
        <h2>二级标题</h2>
        <p>支持 <a href="#">链接</a>、<strong>加粗</strong>、行内 <code>code</code>。</p>
        <blockquote>这是一段引用，左侧有粉色墨版强调。</blockquote>
        <ul>
          <li>列表项一</li>
          <li>列表项二</li>
        </ul>
        <pre><code>const hello = 'world';</code></pre>
      </article>
    </Card>
  </div>
</BaseLayout>
