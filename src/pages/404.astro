---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
---

<BaseLayout title="页面不存在">
  <main class="min-h-[70vh] flex flex-col items-center justify-center px-4 text-center font-mono">
    <p class="font-black text-6xl md:text-8xl text-riso-pink">404</p>
    <h1 class="mt-4 font-bold text-2xl md:text-3xl uppercase tracking-wider">页面不存在</h1>
    <p class="mt-4 text-sm md:text-base text-gray-600">
      你要找的内容可能被移走了，或者从未存在过。
    </p>
    <div class="mt-8">
      <Button href="/">回到首页</Button>
    </div>
  </main>
</BaseLayout>
